# .env.example - Template de variáveis de ambiente
# Copie este arquivo para .env e preencha com seus dados

# BANCO DE DADOS
DB_NAME=seu_banco_de_dados
DB_USER=usuario_db
DB_PASSWORD=sua_senha_super_segura
DB_ROOT_PASSWORD=root_super_seguro
DB_HOST=localhost
DB_PORT=3306

# DJANGO 
SECRET_KEY=sua-chave-secreta-django-super-segura-aqui-mude-isto
DEBUG=True

# CORS (Para comunicar com o frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# AUTENTICAÇÃO JWT
JWT_SECRET=sua-chave-jwt-segura-aqui
JWT_ALGORITHM=HS256
